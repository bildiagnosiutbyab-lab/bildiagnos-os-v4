{
  "manifest_version": 3,
  "name": "Bildiagnos - AD Bildelar Navigator",
  "version": "1.0.0",
  "description": "Navegacion AD Bildelar y transferencia confirmada de piezas a Bildiagnos.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://katalog.adsverige.com/*",
    "https://katalogapi.adsverige.com/*",
    "https://adiapi.adsverige.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://katalog.adsverige.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://katalog.adsverige.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bildiagnosiutbyab-lab.github.io/bildiagnos-os-v4/*",
        "http://localhost/*"
      ],
      "js": ["receiver.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://katalog.adsverige.com/*"]
    }
  ]
}
